# EXTRA. ¿Qué compuerta sale con cada sesgo? (pesos fijos en 0.5 y 0.5)

print("\n" + "=" * 64)
print("EXTRA - EL SESGO COMO PERILLA DE EXIGENCIA (W = [0.5, 0.5])")
print("=" * 64)
print(f"   {'b':>6} | salidas para [0,0] [0,1] [1,0] [1,1] | compuerta")

for sesgo in [-1.2, -1.0, -0.8, -0.6, -0.5, -0.4, -0.3, -0.1, 0.0, 0.2]:
    salidas = [perceptron(np.array(e), np.array([0.5, 0.5]), sesgo)
               for e in TABLA_ENTRADAS]
    if salidas == SALIDAS_AND:
        nombre = "AND"
    elif salidas == SALIDAS_OR:
        nombre = "OR"
    elif salidas == [0, 0, 0, 0]:
        nombre = "siempre 0 (demasiado exigente)"
    elif salidas == [1, 1, 1, 1]:
        nombre = "siempre 1 (nada exigente)"
    else:
        nombre = "otra"
    fila = "     ".join(str(s) for s in salidas)
    print(f"   {sesgo:>6} |               {fila}       | {nombre}")

