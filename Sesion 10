# Un perceptrón hace solo dos cosas:
#   1. Suma ponderada:  Z = (X1 * W1) + (X2 * W2) + b
#   2. Decide:          si Z >= 0 dispara 1; si no, 0
#
# Los pesos (W) dicen qué tan importante es cada entrada.
# El sesgo (b) dice qué tan "exigente" es la neurona para disparar:
# entre más negativo, más puntos necesitan las entradas para superarlo.


import numpy as np

# PUNTO 1. Código del PDF
def funcion_escalon(z):
    if z >= 0:
        return 1
    else:
        return 0


def perceptron(X, W, b):
    Z = np.dot(X, W) + b          # producto punto + sesgo
    salida = funcion_escalon(Z)
    return salida

# Las 4 combinaciones posibles de dos entradas binarias
TABLA_ENTRADAS = [[0, 0], [0, 1], [1, 0], [1, 1]]

SALIDAS_AND = [0, 0, 0, 1]   # solo [1, 1] da 1
SALIDAS_OR  = [0, 1, 1, 1]   # solo [0, 0] da 0


def probar_compuerta(nombre, pesos, sesgo, esperado):
    """Pasa las 4 entradas por la neurona y las compara con lo esperado."""
    pesos = np.array(pesos)
    print(f"\n   {nombre}:  W = {pesos.tolist()},  b = {sesgo}")
    print(f"   {'Entrada':<10}{'Z':>8}{'Salida':>9}{'Esperado':>11}")

    todo_bien = True
    for entrada, esperado_i in zip(TABLA_ENTRADAS, esperado):
        X = np.array(entrada)
        Z = np.dot(X, pesos) + sesgo
        salida = perceptron(X, pesos, sesgo)
        if salida != esperado_i:
            todo_bien = False
        marca = "ok" if salida == esperado_i else "FALLA"
        print(f"   {str(entrada):<10}{Z:>8.2f}{salida:>9}{esperado_i:>11}   {marca}")

    print(f"   >> {'RESUELVE la compuerta' if todo_bien else 'NO resuelve la compuerta'}")
    return todo_bien

